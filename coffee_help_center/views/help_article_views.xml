<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Article List -->
    <record id="view_helpcenter_article_list" model="ir.ui.view">
        <field name="name">coffee.helpcenter.article.list</field>
        <field name="model">coffee.helpcenter.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="sequence"/>
                <field name="published"/>
            </list>
        </field>
    </record>

    <!-- Article Form -->
    <record id="view_helpcenter_article_form" model="ir.ui.view">
        <field name="name">coffee.helpcenter.article.form</field>
        <field name="model">coffee.helpcenter.article</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="sequence"/>
                        <field name="published"/>
                        <field name="content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category List -->
    <record id="view_helpcenter_category_list" model="ir.ui.view">
        <field name="name">coffee.helpcenter.category.list</field>
        <field name="model">coffee.helpcenter.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Category Form -->
    <record id="view_helpcenter_category_form" model="ir.ui.view">
        <field name="name">coffee.helpcenter.category.form</field>
        <field name="model">coffee.helpcenter.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Admin Actions -->
    <record id="action_helpcenter_category_admin" model="ir.actions.act_window">
        <field name="name">Help Categories</field>
        <field name="res_model">coffee.helpcenter.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root Menu -->
    <menuitem id="coffee_helpcenter_root"
              name="Help Center"
              sequence="20"/>

    <!-- Admin Submenus -->
    <menuitem id="coffee_helpcenter_articles_menu"
              name="Articles (Admin)"
              parent="coffee_helpcenter_root"
              action="action_helpcenter_article"
              sequence="1"
              groups="base.group_system"/>

    <menuitem id="coffee_helpcenter_category_menu"
              name="Categories"
              parent="coffee_helpcenter_root"
              action="action_helpcenter_category_admin"
              sequence="2"
              groups="base.group_system"/>

    <!-- ERP / regular user -->
    <record id="action_helpcenter_article_user" model="ir.actions.act_window">
        <field name="name">Help Articles</field>
        <field name="res_model">coffee.helpcenter.article</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('published','=',True)]</field>
        <field name="context">{'readonly_by_default': True}</field>
    </record>

    <menuitem id="coffee_helpcenter_articles_user"
              name="Articles"
              parent="coffee_helpcenter_root"
              action="action_helpcenter_article_user"
              sequence="3"
              groups="base.group_user"/>
</odoo>

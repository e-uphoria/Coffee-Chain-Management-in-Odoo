        <!-- How To Use -->
       
        <record id="view_coffee_crm_help_use" model="ir.ui.view">
            <field name="name">coffee.crm.help.use.form</field>
            <field name="model">coffee.crm.help</field>
            <field name="arch" type="xml">
                <form string="How to Use CRM with Outlets" create="false" edit="false" delete="false" nolabel="1">
                    <sheet>
                        <h2 style="color:#673AB7; font-weight:bold; font-size:28px; margin-bottom:15px; border-bottom:2px solid #673AB7; padding-bottom:8px;">
                            How to Use CRM with Outlets
                        </h2>
                        <div style="font-size:16px; line-height:1.7; color:#2C3E50;">
                            <ol>
                                <li>Create a new <b>Coffee Outlet</b> under Coffee Chain → Outlets.</li>
                                <li>When you save, the system automatically creates a <b>CRM Opportunity</b>.</li>
                                <li>You can view the linked opportunity inside the CRM app.</li>
                                <li>Outlets can also be tied to existing customers (res.partner).</li>
                                <li>Use default CRM features to manage the opportunity:
                                    <ul>
                                        <li><b>Stages:</b> Move leads/opportunities through different stages of your sales pipeline.</li>
                                        <li><b>Activities:</b> Schedule calls, meetings, and tasks related to the opportunity.</li>
                                        <li><b>Notes and Tags:</b> Add internal notes, tags, and labels to organize opportunities.</li>
                                        <li><b>Pipeline View:</b> Visualize your sales funnel and track multiple opportunities at once.</li>
                                        <li><b>Reports:</b> Use CRM reports and dashboards to analyze sales performance for outlets and customers.</li>
                                    </ul>
                                </li>
                            </ol>
                            <br/>
                            This workflow connects outlet operations with sales tracking in CRM and lets you leverage all of Odoo’s standard CRM functionalities for better sales management.
                            <div style="text-align:center; margin-top:20px;">
                                <img src="/coffee_chain/static/src/img/coffee_crm.png" style="max-width:100%; border-radius:6px;" alt="Coffee CRM LEAD Screenshot"/>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>



<odoo>
    <data>
        <!-- List view (replacing tree) -->
        <record id="view_coffee_employee_stage_list" model="ir.ui.view">
            <field name="name">coffee.employee.stage.list</field>
            <field name="model">coffee.employee.stage</field>
            <field name="arch" type="xml">
                <list string="Employee Stages">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_coffee_employee_stage_form" model="ir.ui.view">
            <field name="name">coffee.employee.stage.form</field>
            <field name="model">coffee.employee.stage</field>
            <field name="arch" type="xml">
                <form string="Employee Stage">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
